<%- include('partials/header') %>
<section class="section form-page">
  <a class="back-link" href="<%= game ? `/juegos/${game.slug}` : '/foros' %>">← <%= game ? `Volver a ${game.name}` : 'Volver a los foros' %></a>
  <div class="form-panel"><span class="eyebrow"><span></span> ABRE UNA CONVERSACIÓN</span><h1>Nueva publicación</h1><p class="muted-copy"><%= game ? `Publica directamente en el foro de ${game.name}.` : 'Comparte una pregunta, un consejo o una historia de ruta.' %></p>
    <form action="/publicaciones" method="post" class="form-stack" data-editor-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (game) { %>
        <input type="hidden" name="game" value="<%= game.slug %>">
        <p class="game-post-category"><%= game.categoryName %></p>
      <% } else { %>
        <label>Categoría<select name="category_id" required><% categories.forEach((category) => { %><option value="<%= category.id %>"><%= category.name %></option><% }) %></select></label>
      <% } %>
      <label>Título<input name="title" type="text" minlength="5" maxlength="120" required placeholder="¿De qué quieres conversar?"></label>
      <div class="editor-field">
        <span class="editor-field-label">Contenido</span>
        <%- include('partials/rich-editor', { editorId: 'post-editor', editorLabel: 'Contenido de la publicación' }) %>
        <small>Escribe al menos 10 caracteres o adjunta una imagen o video. Máximo 10.000 caracteres de texto.</small>
      </div>
      <button class="button form-submit" type="submit">Publicar <%= game ? `en ${game.name}` : 'en los foros' %> <span>→</span></button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
