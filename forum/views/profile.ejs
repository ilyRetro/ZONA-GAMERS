<%- include('partials/header') %>
<section class="section profile-page">
  <div class="profile-card">
    <% if (profile.avatar) { %><img class="avatar avatar-profile" src="<%= profile.avatar %>" alt="Avatar de <%= profile.username %>"><% } else { %><span class="avatar avatar-profile avatar-initial"><%= profile.username.slice(0, 1).toUpperCase() %></span><% } %>
    <div class="profile-info"><span class="eyebrow"><span></span> MIEMBRO DE ZONA GAMERS</span><h1><%= profile.username %> <%- include('partials/role-badge', { role: profile.role }) %></h1><p><%= profile.bio || 'Este miembro todavía no ha agregado una biografía.' %></p><span class="profile-date">En la comunidad desde <%= formatDate(profile.created_at) %></span></div>
    <% if (isOwnProfile) { %><a class="button button-outline button-small profile-edit" href="/perfil/editar">Editar perfil</a><% } %>
  </div>
  <% if (canManageRoles && canEditTargetRole) { %>
    <form class="role-management-form" action="/perfil/<%= encodeURIComponent(profile.username) %>/rol" method="post" data-async-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Gestionar rol de <strong><%= profile.username %></strong><select name="role"><% availableRoles.forEach((role) => { %><option value="<%= role %>" <%= role === profile.role ? 'selected' : '' %>><%= roleLabels[role] %></option><% }) %></select></label>
      <button class="button button-small" type="submit">Guardar rol</button>
      <span class="form-feedback" aria-live="polite"></span>
    </form>
  <% } %>
  <div class="profile-stats"><div><strong><%= postCount %></strong><span>publicaciones</span></div><div><strong><%= commentCount %></strong><span>respuestas</span></div></div>
  <div class="section-heading"><div><span class="eyebrow"><span></span> APORTES A LA COMUNIDAD</span><h2>Publicaciones</h2></div></div>
  <% if (posts.length) { %><div class="post-grid"><% posts.forEach((post) => { %><%- include('partials/post-card', { post: { ...post, username: profile.username, avatar: profile.avatar } }) %><% }) %></div><% } else { %><div class="empty-state"><h3>Aún no hay publicaciones</h3><p>Las conversaciones que inicie este miembro aparecerán aquí.</p></div><% } %>
  <div class="section-heading profile-replies-heading"><div><span class="eyebrow"><span></span> CONVERSACIONES</span><h2>Respuestas recientes</h2></div></div>
  <% if (recentComments.length) { %>
    <div class="profile-replies"><% recentComments.forEach((comment) => { %>
      <article class="profile-reply"><span class="tag"><%= comment.category_name || 'Comunidad' %></span><a href="/publicaciones/<%= comment.post_id %>#comentarios"><strong><%= comment.post_title %></strong></a><p><%= richContentToText(comment.content).slice(0, 180) %></p><time><%= formatDateTime(comment.created_at) %></time></article>
    <% }) %></div>
  <% } else { %><p class="muted-copy">Este miembro todavía no ha respondido a publicaciones.</p><% } %>
  <% if (roleAudit.length) { %>
    <div class="section-heading profile-replies-heading"><div><span class="eyebrow"><span></span> ADMINISTRACIÓN</span><h2>Historial de roles</h2></div></div>
    <div class="profile-replies"><% roleAudit.forEach((entry) => { %><article class="profile-reply"><p><%= roleLabels[entry.previous_role] || entry.previous_role %> → <%= roleLabels[entry.new_role] || entry.new_role %> · <%= entry.actor_username || 'Sistema' %></p><time><%= formatDateTime(entry.created_at) %></time></article><% }) %></div>
  <% } %>
</section>
<%- include('partials/footer') %>
