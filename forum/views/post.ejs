<%- include('partials/header') %>
<section class="section post-page">
  <a class="back-link" href="/foros">← Volver a los foros</a>
  <article class="post-detail">
    <span class="tag"><%= post.category_name || 'Comunidad' %></span>
    <h1><%= post.title %></h1>
    <div class="post-meta post-detail-meta"><a class="member-link" href="/perfil/<%= encodeURIComponent(post.username) %>"><% if (post.avatar) { %><img class="avatar avatar-tiny" src="<%= post.avatar %>" alt=""><% } else { %><span class="avatar avatar-tiny avatar-initial"><%= post.username.slice(0, 1).toUpperCase() %></span><% } %><%= post.username %></a><%- include('partials/role-badge', { role: post.role }) %><time datetime="<%= post.created_at %>"><%= formatDateTime(post.created_at) %></time></div>
    <div class="post-content"><%- sanitizeRichContent(post.content) %></div>
    <% if (post.attachments.length) { %><div class="post-attachments" aria-label="Archivos adjuntos"><% post.attachments.forEach((attachment) => { %><% if (attachment.mime_type.startsWith('image/')) { %><a href="<%= attachment.path %>" target="_blank" rel="noopener noreferrer"><img src="<%= attachment.path %>" alt="Imagen adjunta a <%= post.title %>" loading="lazy"></a><% } else { %><video controls preload="metadata"><source src="<%= attachment.path %>" type="<%= attachment.mime_type %>"></video><% } %><% }) %></div><% } %>
    <% if (['moderator', 'admin', 'ceo'].includes(currentUser?.role)) { %><form class="moderation-form" action="/publicaciones/<%= post.id %>/eliminar" method="post" data-confirm="¿Eliminar esta publicación y sus respuestas?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit">Eliminar publicación</button></form><% } %>
  </article>
  <section class="comments-section" id="comentarios">
    <div class="section-heading"><div><span class="eyebrow"><span></span> CONVERSACIÓN</span><h2>Respuestas <span class="inline-count"><%= comments.length %></span></h2></div></div>
    <% if (comments.length) { %><div class="comments-list"><% comments.forEach((comment) => { %>
      <article class="comment-card"><div class="post-meta"><a class="member-link" href="/perfil/<%= encodeURIComponent(comment.username) %>"><% if (comment.avatar) { %><img class="avatar avatar-tiny" src="<%= comment.avatar %>" alt=""><% } else { %><span class="avatar avatar-tiny avatar-initial"><%= comment.username.slice(0, 1).toUpperCase() %></span><% } %><%= comment.username %></a><%- include('partials/role-badge', { role: comment.role }) %><time datetime="<%= comment.created_at %>"><%= formatDateTime(comment.created_at) %></time></div><div class="comment-content"><%- sanitizeRichContent(comment.content) %></div><% if (comment.attachments.length) { %><div class="post-attachments comment-attachments"><% comment.attachments.forEach((attachment) => { %><% if (attachment.mime_type.startsWith('image/')) { %><a href="<%= attachment.path %>" target="_blank" rel="noopener noreferrer"><img src="<%= attachment.path %>" alt="Imagen adjunta a la respuesta" loading="lazy"></a><% } else { %><video controls preload="metadata"><source src="<%= attachment.path %>" type="<%= attachment.mime_type %>"></video><% } %><% }) %></div><% } %><% if (['moderator', 'admin', 'ceo'].includes(currentUser?.role)) { %><form class="moderation-form" action="/publicaciones/<%= post.id %>/comentarios/<%= comment.id %>/eliminar" method="post" data-confirm="¿Eliminar esta respuesta?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet button-small" type="submit">Eliminar respuesta</button></form><% } %></article>
    <% }) %></div><% } else { %><p class="muted-copy">Todavía no hay respuestas. ¡Anímate a iniciar la conversación!</p><% } %>
    <% if (currentUser) { %>
      <form class="reply-form" action="/publicaciones/<%= post.id %>/comentarios" method="post" data-editor-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="editor-field-label">Tu respuesta</span><%- include('partials/rich-editor', { editorId: 'comment-editor', editorLabel: 'Contenido de la respuesta' }) %><small>Escribe al menos 2 caracteres o adjunta una imagen o video. Máximo 2.000 caracteres de texto.</small><button class="button button-small" type="submit">Enviar respuesta →</button></form>
    <% } else { %><div class="reply-signin">¿Quieres responder? <a href="/login">Inicia sesión</a> o <a href="/registro">crea una cuenta</a>.</div><% } %>
  </section>
</section>
<%- include('partials/footer') %>
